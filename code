/*
  MAZE TILT - simple version
  ------------------------------------------------------------
  What this program does:
    1. Listens for a message from the camera computer, like:  -35,80
       (the first number is the player's X position, the second is Y).
    2. Turns those numbers into a "target" for each motor, measured
       in steps away from the middle (level) position.
    3. Moves both motors, one tiny step at a time, until they reach
       their targets.

  IMPORTANT - STARTING POSITION:
    The platform must be LEVEL when the Arduino is switched on (and every
    time the Arduino restarts). The program assumes that moment is
    position 0 and counts all movement from there.
    Tip: opening the Serial connection from a computer usually restarts
    the Arduino, so make sure the platform is level before you connect.
*/

#include <Stepper.h>   // the library that knows how to turn a stepper motor

// ------------------------------------------------------------
// SETTINGS YOU MAY WANT TO CHANGE
// ------------------------------------------------------------

// Steps for one full turn of the 28BYJ-48's output shaft.
// The motor has 32 steps inside, plus a gearbox of about 64:1.
// 32 x 64 = 2048. (The old value 4096 is for "half-steps", which the
// Stepper library does not use, so 2048 is the right number here.)
const int STEPS = 2048;

// Motor speed in turns per minute. The 28BYJ-48 is a slow motor.
// Going above about 10-12 can make it skip steps or stall.
// If a motor buzzes but does not turn, try a LOWER number.
const int MOTOR_RPM = 9;

// The platform can tilt this many steps either side of the middle.
// This is the physical limit - the code never goes past it.
const int MAX_STEPS = 500;

// The camera sends numbers from -CAMERA_RANGE to +CAMERA_RANGE.
// 0 means "in the middle". CHANGE THIS to match your camera program.
const int CAMERA_RANGE = 500;

// If the camera sends 0..640 instead of -100..100, set the "middle" value
// here (for example 320) and set CAMERA_RANGE to the distance from the
// middle to the edge (also 320). If the camera already sends 0 for the
// middle, leave these at 0.
const int CAMERA_CENTER_X = 0;
const int CAMERA_CENTER_Y = 0;

// DEAD ZONE: if the player is close to the middle (less than this many
// steps from it), the platform just stays level instead of wobbling.
const int DEAD_ZONE = 50;

// TOLERANCE: ignore tiny changes. The target only changes if the new one
// is at least this many steps different. This stops jitter from the camera.
const int steady_tolerance = 10;

// If a motor tilts the WRONG WAY, change its direction from 1 to -1.
const int X_DIRECTION = -1;
const int Y_DIRECTION = 1;

// ------------------------------------------------------------
// PIN NUMBERS (the 4 wires from each ULN2003 driver board)
// IN1..IN4 are the labels printed on the driver board.
// ------------------------------------------------------------
const int X_IN1 = 8;
const int X_IN2 = 9;
const int X_IN3 = 10;
const int X_IN4 = 11;

const int Y_IN1 = 3;
const int Y_IN2 = 4;
const int Y_IN3 = 5;
const int Y_IN4 = 6;

// ------------------------------------------------------------
// THE MOTORS
// For the 28BYJ-48 the Stepper library needs the pins in this order:
//     IN1, IN3, IN2, IN4        (notice 3 comes before 2!)
// If the order is wrong the motor shakes or buzzes instead of turning.
// ------------------------------------------------------------
Stepper stepper_x(STEPS, X_IN1, X_IN3, X_IN2, X_IN4);
Stepper stepper_y(STEPS, Y_IN1, Y_IN3, Y_IN2, Y_IN4);

// ------------------------------------------------------------
// MEMORY OF WHERE EVERYTHING IS (all measured in steps from level)
// ------------------------------------------------------------
int x_current = 0;   // where the X motor is now
int x_target  = 0;   // where we want the X motor to be
int y_current = 0;   // where the Y motor is now
int y_target  = 0;   // where we want the Y motor to be

// ------------------------------------------------------------
// setup() runs ONCE when the Arduino starts
// ------------------------------------------------------------
void setup() {
  Serial.begin(115200);       // the camera program must use 115200 too
  Serial.setTimeout(20);      // don't wait long for numbers (20 ms)

  stepper_x.setSpeed(MOTOR_RPM);
  stepper_y.setSpeed(MOTOR_RPM);

// debugging message
  // Serial.println("tilt sketch ready");

}

// ------------------------------------------------------------
// calculate_target()
// Turns a camera number into a motor target in steps.
// ------------------------------------------------------------
int calculate_target(int camera_value) {

  // Step 1: scale. -CAMERA_RANGE..+CAMERA_RANGE becomes -170..+170.
  int target = map(camera_value, -CAMERA_RANGE, CAMERA_RANGE,
                   -MAX_STEPS, MAX_STEPS);

  // Step 2: safety limit. Even if the camera sends a crazy number,
  // the target can never go past +/- MAX_STEPS.
  target = constrain(target, -MAX_STEPS, MAX_STEPS);

  // Step 3: dead zone. Close to the middle? Then stay level.
  if (target > -DEAD_ZONE && target < DEAD_ZONE) {
    target = 0;
  }

  return target;
}

// ------------------------------------------------------------
// apply_tolerance()
// Decides whether to use the new target or keep the old one.
// ------------------------------------------------------------
int apply_tolerance(int old_target, int new_target) {

  // Always allow going back to level or to the very edge,
  // so the platform can settle exactly there.
  if (new_target == 0 || abs(new_target) == MAX_STEPS) {
    return new_target;
  }

  // Only accept the new target if it is far enough from the old one.
  if (abs(new_target - old_target) >= steady_tolerance) {
    return new_target;
  }

  // Otherwise ignore the tiny change.
  return old_target;
}

// ------------------------------------------------------------
// x_motor_move() and y_motor_move()
// Each one takes AT MOST ONE step toward the target, then returns.
// Because each call is only one step, loop() can alternate between
// the two motors and they both move at (almost) the same time.
// (The old way, step(many), moved one motor fully, then the other.)
// ------------------------------------------------------------
void x_motor_move() {
  if (x_current < x_target) {
    stepper_x.step(X_DIRECTION);      // one step forward
    x_current++;
  } else if (x_current > x_target) {
    stepper_x.step(-X_DIRECTION);     // one step backward
    x_current--;
  }
  // if they are equal, we are already there: do nothing
}

void y_motor_move() {
  if (y_current < y_target) {
    stepper_y.step(Y_DIRECTION);
    y_current++;
  } else if (y_current > y_target) {
    stepper_y.step(-Y_DIRECTION);
    y_current--;
  }
}

// ------------------------------------------------------------
// loop() runs OVER AND OVER, forever
// ------------------------------------------------------------
void loop() {

  // 1. Has a message arrived from the camera computer?
  //    It looks like "-35,80" followed by a new line.
  if (Serial.available() > 0) {
    int x_in = Serial.parseInt();   // reads the first number (can be negative)
    int y_in = Serial.parseInt();   // reads the second number
    Serial.readStringUntil('\n');   

    // Turn each camera number into a target, then apply the tolerance.
    x_target = apply_tolerance(x_target,
                 calculate_target(x_in - CAMERA_CENTER_X));

    // If the platform tilts the wrong way in Y, put a minus sign in front
    // of the bracket, like this:  calculate_target(-(y_in - CAMERA_CENTER_Y))
    y_target = apply_tolerance(y_target,
                 calculate_target(y_in - CAMERA_CENTER_Y));

    // more debugging messages
    // Serial.print("got ");        Serial.print(x_in);     Serial.print(",");  Serial.print(y_in);
    // Serial.print("  targets "); Serial.print(x_target); Serial.print(","); Serial.println(y_target);
  }

  // 2. Take one step with each motor (if it still needs to move).
  x_motor_move();
  y_motor_move();
}

